<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\DevSwitch.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\DevSwitch.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="11.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="11.0.0" />
  </ItemGroup>

</Project>
