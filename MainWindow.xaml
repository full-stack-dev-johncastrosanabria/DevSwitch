<Window x:Class="DevSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevSwitch" Icon="Assets/DevSwitch.ico" Width="760" Height="720" MinWidth="560" MinHeight="420"
        Background="#F4F5F7" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#1F2328"/>
        <SolidColorBrush x:Key="Muted" Color="#5F6670"/>
        <SolidColorBrush x:Key="Line" Color="#DDE1E6"/>
        <SolidColorBrush x:Key="Accent" Color="#2F6FEB"/>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Width" Value="96"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Background" Value="#C9CED6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Background" Value="#C2410C"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header: total RAM -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,16">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="Memoria del equipo" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                    <TextBlock x:Name="RamText" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom"/>
                </DockPanel>
                <ProgressBar x:Name="RamBar" Height="8" Margin="0,10,0,0" Maximum="100" Foreground="{StaticResource Accent}" Background="#E6E9EE" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- Admin banner -->
        <Border x:Name="AdminBanner" DockPanel.Dock="Top" Background="#FFF4D6" BorderBrush="#F0D58C" BorderThickness="0,0,0,1" Padding="20,10">
            <DockPanel>
                <Button Content="Abrir como administrador" DockPanel.Dock="Right" Click="Elevate_Click" Padding="12,4" Margin="12,0,0,0"/>
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#5C4400"
                           Text="Para encender o apagar servicios de Windows como SQL Server, la app necesita permisos de administrador."/>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,8">
            <TextBlock x:Name="StatusLine" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Text="Leyendo estado…"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="List" Margin="16,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                            <Setter Property="Opacity" Value="0.55"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse Width="10" Height="10" Margin="0,6,12,0" VerticalAlignment="Top">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#AEB5BF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Fill" Value="#1F9D55"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Ink}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <CheckBox Content="Iniciar con Windows" Margin="0,8,0,0" Foreground="{StaticResource Muted}"
                                              IsChecked="{Binding AutoStart, Mode=OneWay}" IsEnabled="{Binding CanToggleAutoStart}"
                                              Click="AutoStart_Click">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SupportsAutoStart}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding MemoryText}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource Ink}"/>
                                    <TextBlock Text="RAM" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11"/>
                                </StackPanel>

                                <Button Grid.Column="3" Style="{StaticResource ActionButton}" VerticalAlignment="Center"
                                        Content="{Binding ActionText}" IsEnabled="{Binding CanAct}" Click="Toggle_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
